{
  "name": "mens-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the anonymous men's virtual counseling, coaching, mentoring, and support platform.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:api && npm run typecheck:vercel",
    "build:api": "nest build api && node scripts/copy-generated.js",
    "typecheck:vercel": "tsc -p tsconfig.vercel.json",
    "start:api": "node scripts/copy-generated.js && nest start api",
    "start:api:dev": "node scripts/copy-generated.js && nest start api --watch",
    "lint": "eslint \"apps/**/*.ts\" \"api/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.ts\" \"api/**/*.ts\"",
    "prisma:generate": "npm run prisma:generate:core && npm run prisma:generate:vault",
    "prisma:generate:core": "prisma generate --schema=prisma/core/schema.prisma && node scripts/copy-generated.js",
    "prisma:generate:vault": "prisma generate --schema=prisma/vault/schema.prisma",
    "prisma:migrate:core": "prisma migrate dev --schema=prisma/core/schema.prisma",
    "prisma:migrate:vault": "prisma migrate dev --schema=prisma/vault/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "vercel-build": "npm run prisma:generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.20.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vercel/node": "^5.10.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
