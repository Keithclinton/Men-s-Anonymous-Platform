// App-core database: pseudonymous data only. No real name/email/phone here — ever.
// See ARCHITECTURE.md §3 (Identity Vault Separation) and §5 (Data Model).

generator client {
  provider      = "prisma-client-js"
  output        = "../../apps/api/src/generated/prisma-core"
  // "native" for local dev; the rhel-openssl targets are Prisma's documented requirement
  // for deploying to Vercel serverless functions (Amazon Linux under the hood) — see
  // https://www.prisma.io/docs/orm/prisma-client/deployment/serverless/deploy-to-vercel.
  // Including both openssl targets is a small size cost but avoids guessing which Amazon
  // Linux version a given Vercel runtime update lands on.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BillingType {
  MINIMUM
  HOURLY
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ChannelType {
  CHAT
  VIDEO
}

enum PaymentProviderType {
  MPESA
  PESAPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentDirection {
  CHARGE
  PAYOUT
}

enum SubscriptionStatus {
  ACTIVE
  LAPSED
  CANCELED
}

enum ProviderKind {
  COUNSELOR
  MODERATOR
}

/// Sub-roles within Role.ADMIN — see ARCHITECTURE.md §9a. SUPER_ADMIN has every permission;
/// the others are scoped. Null on an ADMIN row means "not yet assigned a scope" and should
/// be treated as no admin permissions at all (see StaffRolesGuard).
enum StaffRole {
  SUPPORT_AGENT
  STAFF_MODERATOR
  COMPLIANCE_OFFICER
  SUPER_ADMIN
}

enum ResourceType {
  ARTICLE
  VIDEO
}

/// What a counselor/moderator may see for a scoped relationship. Product rules §2.
enum RevealLevel {
  ANONYMOUS
  FIRST_NAME
  FULL_NAME
  NAME_PHOTO
}

/// Addressed everywhere by pseudonym_id. Real identity lives only in the vault database.
model User {
  id           String     @id @default(uuid())
  /// Pseudonymous handle, chosen at signup. Not PII — safe to live in the app core.
  username     String     @unique
  passwordHash String
  role         Role
  /// Only meaningful when role = ADMIN — see StaffRole above.
  staffRole    StaffRole?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  providerProfile ProviderProfile?
  clientProfile   ClientProfile?

  bookingsAsClient   Booking[] @relation("BookingClient")
  bookingsAsProvider Booking[] @relation("BookingProvider")

  availabilitySlots AvailabilitySlot[]

  payments      Payment[]
  subscriptions Subscription[]
  feedbackGiven Feedback[]

  supportGroupMemberships SupportGroupMembership[]

  revealsAsClient   IdentityRevealGrant[] @relation("RevealClient")
  revealsAsProvider IdentityRevealGrant[] @relation("RevealProvider")

  @@map("users")
}

/// Public-facing, pseudonymous. Real credentials/verification docs stay in the vault.
model ProviderProfile {
  userId       String       @id
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  bio          String?
  kind         ProviderKind @default(COUNSELOR)
  specialties  String[]
  rateCard     Json?
  availability Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("provider_profiles")
}

/// Provider-published bookable times. Booking a slot atomically claims it (bookingId set) —
/// see booking.service.ts#createBooking. Distinct from ProviderProfile.availability, which is
/// just free-form prose.
model AvailabilitySlot {
  id          String   @id @default(uuid())
  providerId  String
  provider    User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  start       DateTime
  durationMin Int
  /// Null = open. Set exactly once, when a client books it.
  bookingId   String?  @unique
  booking     Booking? @relation(fields: [bookingId], references: [id])
  createdAt   DateTime @default(now())

  @@index([providerId])
  @@map("availability_slots")
}

model ClientProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json?
  /// Encrypted at the application layer before it ever reaches this column.
  intakeNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_profiles")
}

/// Client-controlled, scoped disclosure. Not a public profile field — see product-rules §2 / §4.
/// Names/photo here are a client-supplied projection for this grant only (vault PII stays vaulted).
model IdentityRevealGrant {
  id         String      @id @default(uuid())
  clientId   String
  client     User        @relation("RevealClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId String
  provider   User        @relation("RevealProvider", fields: [providerId], references: [id], onDelete: Cascade)
  /// Optional: limit the grant to one booking/session relationship.
  bookingId  String?
  level      RevealLevel @default(ANONYMOUS)
  firstName  String?
  fullName   String?
  photoUrl   String?
  active     Boolean     @default(true)
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([clientId])
  @@index([providerId])
  @@index([bookingId])
  @@map("identity_reveal_grants")
}

model Booking {
  id                  String        @id @default(uuid())
  clientId            String
  client              User          @relation("BookingClient", fields: [clientId], references: [id])
  providerId          String
  provider            User          @relation("BookingProvider", fields: [providerId], references: [id])
  scheduledStart      DateTime
  durationMin         Int
  billingType         BillingType
  status              BookingStatus @default(REQUESTED)
  /// Set only by the auto-match flow (ARCHITECTURE.md §10b) — direct bookings go straight
  /// to CONFIRMED against a provider's published slot and never need this.
  specialty           String?
  /// The kind constraint the client asked for at request time (null = either). Carried
  /// through reassignment so a re-match doesn't drift from what was actually requested.
  kind                ProviderKind?
  /// Providers who declined (or timed out on) this request, so re-matching doesn't loop
  /// back to them. Only meaningful alongside `specialty`.
  declinedProviderIds String[]      @default([])
  /// Auto-match accept/decline deadline (ARCHITECTURE.md §10b). Set on request/reassignment,
  /// cleared on confirm/cancel. A scheduled sweep (no persistent worker on serverless — see
  /// MatchingService.sweepExpired) reassigns/cancels anything still REQUESTED past this.
  matchExpiresAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  session  Session?
  payments Payment[]
  slot     AvailabilitySlot?

  @@index([clientId])
  @@index([providerId])
  @@index([status, matchExpiresAt])
  @@map("bookings")
}

/// Metadata only — never message/video content. See ARCHITECTURE.md §6.
model Session {
  id          String      @id @default(uuid())
  bookingId   String      @unique
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channelType ChannelType
  roomRef     String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime    @default(now())

  feedback Feedback?

  @@map("sessions")
}

model Payment {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  /// Null for subscription charges/payouts that aren't tied to one session.
  bookingId   String?
  booking     Booking?            @relation(fields: [bookingId], references: [id])
  provider    PaymentProviderType
  /// M-Pesa CheckoutRequestID / Pesapal OrderTrackingId — the idempotency key.
  externalRef String              @unique
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("KES")
  status      PaymentStatus       @default(PENDING)
  direction   PaymentDirection    @default(CHARGE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@map("payments")
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  plan             String
  sessionsIncluded Int
  renewalDate      DateTime
  status           SubscriptionStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model Feedback {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation(fields: [raterId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("feedback")
}

model SupportGroup {
  id        String   @id @default(uuid())
  topic     String
  schedule  DateTime
  capacity  Int
  createdAt DateTime @default(now())

  memberships SupportGroupMembership[]

  @@map("support_groups")
}

model SupportGroupMembership {
  id       String       @id @default(uuid())
  groupId  String
  group    SupportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id])
  joinedAt DateTime     @default(now())

  @@unique([groupId, userId])
  @@map("support_group_memberships")
}

model ResourceLibraryItem {
  id        String       @id @default(uuid())
  type      ResourceType
  title     String
  body      String?
  url       String?
  tags      String[]
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("resource_library_items")
}

/// Every sensitive admin/system action, especially anything touching the vault. No exceptions.
model AuditLog {
  id             String   @id @default(uuid())
  actorPseudonym String
  action         String
  target         String
  metadata       Json?
  timestamp      DateTime @default(now())

  @@index([actorPseudonym])
  @@index([timestamp])
  @@map("audit_logs")
}
