// App-core database: pseudonymous data only. No real name/email/phone here — ever.
// See ARCHITECTURE.md §3 (Identity Vault Separation) and §5 (Data Model).

generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/src/generated/prisma-core"
}

// apps/worker never touches either database directly — it triggers work (e.g. billing
// reconciliation) over an internal HTTP call into apps/api, which owns all DB/gateway
// access. See ARCHITECTURE.md §11b and apps/worker/src/processors/.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BillingType {
  MINIMUM
  HOURLY
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ChannelType {
  CHAT
  VIDEO
}

enum PaymentProviderType {
  MPESA
  PESAPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentDirection {
  CHARGE
  PAYOUT
}

enum SubscriptionStatus {
  ACTIVE
  LAPSED
  CANCELED
}

enum ResourceType {
  ARTICLE
  VIDEO
}

/// What a counselor/moderator may see for a scoped relationship. Product rules §2.
enum RevealLevel {
  ANONYMOUS
  FIRST_NAME
  FULL_NAME
  NAME_PHOTO
}

/// Addressed everywhere by pseudonym_id. Real identity lives only in the vault database.
model User {
  id           String     @id @default(uuid())
  /// Pseudonymous handle, chosen at signup. Not PII — safe to live in the app core.
  username     String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  providerProfile ProviderProfile?
  clientProfile   ClientProfile?

  bookingsAsClient   Booking[] @relation("BookingClient")
  bookingsAsProvider Booking[] @relation("BookingProvider")

  payments      Payment[]
  subscriptions Subscription[]
  feedbackGiven Feedback[]

  supportGroupMemberships SupportGroupMembership[]

  revealsAsClient   IdentityRevealGrant[] @relation("RevealClient")
  revealsAsProvider IdentityRevealGrant[] @relation("RevealProvider")

  @@map("users")
}

/// Public-facing, pseudonymous. Real credentials/verification docs stay in the vault.
model ProviderProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  bio          String?
  specialties  String[]
  rateCard     Json?
  availability Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("provider_profiles")
}

model ClientProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences  Json?
  /// Encrypted at the application layer before it ever reaches this column.
  intakeNotes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("client_profiles")
}

/// Client-controlled, scoped disclosure. Not a public profile field — see product-rules §2 / §4.
/// Names/photo here are a client-supplied projection for this grant only (vault PII stays vaulted).
model IdentityRevealGrant {
  id         String      @id @default(uuid())
  clientId   String
  client     User        @relation("RevealClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId String
  provider   User        @relation("RevealProvider", fields: [providerId], references: [id], onDelete: Cascade)
  /// Optional: limit the grant to one booking/session relationship.
  bookingId  String?
  level      RevealLevel @default(ANONYMOUS)
  firstName  String?
  fullName   String?
  photoUrl   String?
  active     Boolean     @default(true)
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([clientId])
  @@index([providerId])
  @@index([bookingId])
  @@map("identity_reveal_grants")
}

model Booking {
  id            String        @id @default(uuid())
  clientId      String
  client        User          @relation("BookingClient", fields: [clientId], references: [id])
  providerId    String
  provider      User          @relation("BookingProvider", fields: [providerId], references: [id])
  scheduledStart DateTime
  durationMin   Int
  billingType   BillingType
  status        BookingStatus @default(REQUESTED)
  /// Set only by the auto-match flow (ARCHITECTURE.md §10b) — direct bookings go straight
  /// to CONFIRMED against a provider's published slot and never need this.
  specialty            String?
  /// Providers who declined (or timed out on) this request, so re-matching doesn't loop
  /// back to them. Only meaningful alongside `specialty`.
  declinedProviderIds  String[] @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  session  Session?
  payments Payment[]

  @@index([clientId])
  @@index([providerId])
  @@map("bookings")
}

/// Metadata only — never message/video content. See ARCHITECTURE.md §6.
model Session {
  id          String       @id @default(uuid())
  bookingId   String       @unique
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channelType ChannelType
  roomRef     String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime     @default(now())

  feedback Feedback?

  @@map("sessions")
}

model Payment {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  /// Null for subscription charges/payouts that aren't tied to one session.
  bookingId   String?
  booking     Booking?            @relation(fields: [bookingId], references: [id])
  provider    PaymentProviderType
  /// M-Pesa CheckoutRequestID / Pesapal OrderTrackingId — the idempotency key.
  externalRef String              @unique
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("KES")
  status      PaymentStatus       @default(PENDING)
  direction   PaymentDirection    @default(CHARGE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@map("payments")
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  plan             String
  sessionsIncluded Int
  renewalDate      DateTime
  status           SubscriptionStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model Feedback {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation(fields: [raterId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("feedback")
}

model SupportGroup {
  id        String                    @id @default(uuid())
  topic     String
  schedule  DateTime
  capacity  Int
  createdAt DateTime                  @default(now())

  memberships SupportGroupMembership[]

  @@map("support_groups")
}

model SupportGroupMembership {
  id             String       @id @default(uuid())
  groupId        String
  group          SupportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())

  @@unique([groupId, userId])
  @@map("support_group_memberships")
}

model ResourceLibraryItem {
  id        String       @id @default(uuid())
  type      ResourceType
  title     String
  body      String?
  url       String?
  tags      String[]
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("resource_library_items")
}

/// Every sensitive admin/system action, especially anything touching the vault. No exceptions.
model AuditLog {
  id             String   @id @default(uuid())
  actorPseudonym String
  action         String
  target         String
  metadata       Json?
  timestamp      DateTime @default(now())

  @@index([actorPseudonym])
  @@index([timestamp])
  @@map("audit_logs")
}
