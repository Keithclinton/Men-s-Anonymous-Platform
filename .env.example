# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated allowlist for browser requests (e.g. "http://localhost:5173"). Unset
# reflects the request origin, which is convenient for local dev but too permissive to
# ship — set this explicitly before deploying anywhere real.
CORS_ORIGIN=

# --- Databases (kept separate on purpose — see ARCHITECTURE.md §3) ---
# App core: pseudonymous data only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5442/mens_platform_core?schema=public"
# Identity vault: real PII, isolated instance/network.
VAULT_DATABASE_URL="postgresql://postgres:postgres@localhost:5443/mens_platform_vault?schema=public"

# --- Redis (cache, rate limiting, BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-too-dev-only"
JWT_REFRESH_TTL="30d"

# --- Field-level encryption for vault PII (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this must come from KMS/Vault, not a flat env var.
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Separate key for deterministic HMAC lookups (e.g. "does this email already have an
# account" during recovery) without making the encrypted value itself queryable. Same
# generation method, must NOT equal ENCRYPTION_KEY.
HASH_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# --- Worker <-> API (internal, machine-to-machine only) ---
# Shared secret the worker sends on scheduled calls like the billing reconciliation
# sweep, so those endpoints can stay outside normal user JWT auth. See ARCHITECTURE.md §11b.
INTERNAL_API_SECRET="change-me-dev-only"
API_INTERNAL_URL="http://localhost:3000"

# --- M-Pesa (Safaricom Daraja) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="https://<your-public-tunnel>/billing/mpesa/callback"
# B2C (provider payouts) — separate Daraja product/approval, see ARCHITECTURE.md §11b
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
