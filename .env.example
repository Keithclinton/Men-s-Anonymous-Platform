# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated allowlist for browser requests (e.g. "http://localhost:5173"). Unset
# reflects the request origin, which is convenient for local dev but too permissive to
# ship — set this explicitly before deploying anywhere real.
CORS_ORIGIN=

# --- Databases (kept separate on purpose — see ARCHITECTURE.md §3) ---
# App core: pseudonymous data only.
# Local dev: the docker-compose Postgres below. On Vercel: two separate Neon projects/
# databases (not two databases in one project — keep them as separate instances, same as
# local, so the vault stays a genuinely different blast radius). Use Neon's POOLED
# connection string (the "-pooler" hostname), not the direct one — serverless functions
# can spin up many concurrent instances, each holding its own connection, and Postgres's
# connection limit runs out fast without PgBouncer-style pooling in front of it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5442/mens_platform_core?schema=public"
# Identity vault: real PII, isolated instance/network. Same pooled-connection-string note.
VAULT_DATABASE_URL="postgresql://postgres:postgres@localhost:5443/mens_platform_vault?schema=public"

# --- Redis (rate-limit storage) ---
# Local dev: the docker-compose Redis below. On Vercel: Upstash Redis via the Vercel
# Marketplace — use the standard TCP/TLS connection string (rediss://...), not the REST
# API endpoint; ioredis needs the real Redis protocol.
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-too-dev-only"
JWT_REFRESH_TTL="30d"

# --- Field-level encryption for vault PII (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this must come from KMS/Vault, not a flat env var.
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Separate key for deterministic HMAC lookups (e.g. "does this email already have an
# account" during recovery) without making the encrypted value itself queryable. Same
# generation method, must NOT equal ENCRYPTION_KEY.
HASH_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# --- Scheduled sweeps (billing reconciliation, match-expiry) ---
# No persistent worker process on serverless — these run as Vercel Cron Jobs instead (see
# vercel.json), hitting their endpoints directly rather than through a queue. Vercel
# automatically sends `Authorization: Bearer $CRON_SECRET` on cron-triggered requests when
# this env var is set on the project — set the SAME value here and in Vercel's dashboard.
# For local testing, call the endpoint yourself with that header.
CRON_SECRET="change-me-dev-only"

# --- M-Pesa (Safaricom Daraja) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="https://<your-public-tunnel>/billing/mpesa/callback"
# B2C (provider payouts) — separate Daraja product/approval, see ARCHITECTURE.md §11b
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
