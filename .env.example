# App Core PostgreSQL
DATABASE_URL=postgresql://map:map_secret@localhost:5432/map_core?schema=public

# Identity Vault PostgreSQL (isolated)
VAULT_DATABASE_URL=postgresql://map:map_secret@localhost:5433/map_vault?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Field encryption (32-byte key, base64). Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# API
PORT=3000
NODE_ENV=development

# M-Pesa Daraja (sandbox) — leave empty until credentials issued
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-tunnel.example/billing/mpesa/callback

# Video provider (pick one later)
VIDEO_PROVIDER=daily
DAILY_API_KEY=
